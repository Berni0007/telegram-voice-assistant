# Copy to .env for local development. Never commit the real .env file.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NVIDIA_API_KEY=your_nvidia_api_key

# NVIDIA LLM
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# NVIDIA Chatterbox TTS
NVIDIA_TTS_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
TTS_LANGUAGE=ru-RU
TTS_VOICE=Chatterbox-Multilingual.ru-RU.Male
TTS_SAMPLE_RATE=22050
TTS_CHUNK_MAX_CHARS=180
TTS_CHUNK_MAX_WORDS=24
TTS_CHUNK_RETRIES=3
TTS_PLAYBACK_SPEED=0.90
TTS_PARALLEL_CHUNKS=2

# NVIDIA Parakeet multilingual ASR
NVIDIA_ASR_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_ASR_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
ASR_LANGUAGE=ru-RU

# Persistent memory
BOT_MEMORY_DB=bot_memory.db
MEMORY_RECENT_MESSAGES=24
MEMORY_SUMMARY_TRIGGER=36
MEMORY_KEEP_UNSUMMARIZED=12

# v5.2 structured + semantic memory
MEMORY_STRUCTURED_ENABLED=1
MEMORY_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
MEMORY_SEMANTIC_TOP_K=6
MEMORY_MIN_SIMILARITY=0.34
MEMORY_EXTRACT_INTERVAL=2
MEMORY_MAX_ITEMS=120

# Conversational continuity
USER_TIMEZONE=Europe/Moscow

# Isolated project memory
PROJECT_RECENT_MESSAGES=28
PROJECT_SUMMARY_TRIGGER=12
PROJECT_SUMMARY_MAX_CHARS=5000

# Automatic project routing (remote lightweight classifier; no local model)
AUTO_PROJECT_ENABLED=1
# AUTO_PROJECT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AUTO_PROJECT_MIN_CONFIDENCE=0.84
AUTO_PROJECT_GENERAL_CONFIDENCE=0.94

# Remote NVIDIA image/screenshot understanding
VISION_ENABLED=1
VISION_MODEL=google/gemma-3n-e4b-it
VISION_MAX_BYTES=3500000
VISION_MAX_TOKENS=1100

# Reminders / scheduled messages
REMINDER_TIMEZONE=Europe/Moscow

# Personality / spoken-text layer
SPEECH_REWRITE_ENABLED=1
# PERSONALITY_ENGINE_PROMPT=
# LLM_SYSTEM_PROMPT=

# Web search
WEB_SEARCH_ENABLED=1
WEB_SEARCH_RESULTS=5
WEB_FETCH_PAGES=3
WEB_TIMEOUT_SECONDS=10
WEB_MAX_PAGE_CHARS=5000
WEB_MAX_CONTEXT_CHARS=18000

# Deep research mode
RESEARCH_RESULTS=12
RESEARCH_FETCH_PAGES=7
RESEARCH_MAX_CONTEXT_CHARS=36000
